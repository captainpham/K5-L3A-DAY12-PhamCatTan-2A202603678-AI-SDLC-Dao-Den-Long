{
  "name": "dao-den-long",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Đảo Đèn Lồng — 3D third-person game (Day 12 AI SDLC lab)",
  "scripts": {
    "build": "npm run build:headless && npm run build:web",
    "build:headless": "esbuild src/headless/cli.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/headless.cjs",
    "build:web": "vite build",
    "dev": "vite",
    "start": "vite preview --port 4173 --strictPort",
    "headless": "node dist/headless.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "proof": "npm run build:headless && node scripts/proof.mjs"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/three": "0.160.0",
    "esbuild": "0.24.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
